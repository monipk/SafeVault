    android:orientation="vertical" android:padding="20dp" android:background="@drawable/widget_background"
    android:gravity="center_vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="SAFE VAULT" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Your private space. One tap away."
        android:textColor="#BEE0D6" android:textSize="13sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
